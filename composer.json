{
  "name": "asvvizit/streamtalk",
  "version": "0.1.3",
  "description": "Laravel package for real-time chat system implementation",
  "type": "library",
  "keywords": [
    "laravel",
    "messenger",
    "conversations",
    "chat",
    "php",
    "pusher",
    "realtime",
    "real-time",
    "StreamTalk"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Sergey Andrianov",
      "email": "dillerasvasviner@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^7.3 || ^8.0",
    "pusher/pusher-php-server": "^5.0 || ^6.0 || ^7.0 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "StreamTalk\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "StreamTalk\\StreamTalkServiceProvider"
      ],
      "aliases": {
        "StreamTalk": "StreamTalk\\Facades\\StreamTalkMessenger"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "email": "dillerasvasviner@gmail.com",
    "issues": "https://github.com/asvvizit/streamtalk/issues",
    "source": "https://github.com/asvvizit/streamtalk"
  },
  "homepage": "https://github.com/asvvizit/streamtalk",
  "scripts": {
    "post-autoload-dump": [
      "@php artisan vendor:publish --tag=streamtalk-config --ansi"
    ],
    "post-update-cmd": [
      "php -r \"file_put_contents('composer.json', preg_replace('/\\\"version\\\":\\s*\\\"[^\\\"]+\\\"/', '\"version\": \"' . include 'version.php' . '\"', file_get_contents('composer.json')));\""
    ],
    "post-install-cmd": [
      "@post-update-cmd"
    ]
  },
  "conflict": {
    "laravel/framework": "<8.0 || >=13.0"
  }
}
